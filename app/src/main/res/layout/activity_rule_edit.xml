<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="规则名称 *" android:textColor="@color/text_primary" />

        <EditText android:id="@+id/et_name"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="例如：某小说App开屏" android:textColorHint="@color/text_hint"
            android:textColor="@color/text_primary" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="关键词（多个用逗号分隔）" android:textColor="@color/text_primary" />

        <EditText android:id="@+id/et_keyword"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="跳过,Skip,关闭广告" android:textColorHint="@color/text_hint"
            android:textColor="@color/text_primary" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="控件ID（多个用逗号分隔）" android:textColor="@color/text_primary" />

        <EditText android:id="@+id/et_viewid"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="iv_close,btn_skip" android:textColorHint="@color/text_hint"
            android:textColor="@color/text_primary" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="限定包名（留空=全局生效）" android:textColor="@color/text_primary" />

        <EditText android:id="@+id/et_pkg"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="com.example.app" android:textColorHint="@color/text_hint"
            android:textColor="@color/text_primary" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:textSize="12sp"
            android:textColor="@color/text_hint"
            android:text="提示：关键词和控件ID至少填一项。控件ID可用 Android Studio 的 Layout Inspector 查看。" />

        <Button android:id="@+id/btn_save"
            style="@style/PrimaryButton"
            android:layout_marginTop="24dp" android:text="保存" />
    </LinearLayout>
</ScrollView>
